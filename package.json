{
  "name": "custom-subtitles",
  "version": "1.3.0",
  "private": true,
  "description": "Personal Stremio subtitle library with a web upload interface",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/launcher.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "build:windows": "powershell -NoProfile -File scripts/build-windows.ps1"
  }
}
