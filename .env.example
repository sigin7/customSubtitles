# Node.js 24+. Copy this file to .env if you want to customize the server.
HOST=127.0.0.1
PORT=7000
# Public gateway stays on loopback; Tailscale Funnel provides public HTTPS.
PUBLIC_PORT=7001
FUNNEL_HTTPS_PORT=8443
# Initial addon origin. The address saved through the UI takes precedence.
# BASE_URL=https://your-computer.your-tailnet.ts.net:8443
# Optional private administration origin if you also keep Tailscale Serve.
# ADMIN_BASE_URL=https://your-computer.your-tailnet.ts.net
# Optional environment-managed password instead of first-run local setup.
# ADMIN_PASSWORD=replace-with-a-long-private-password
# OPEN_BROWSER=false
# DATA_DIR=./data
